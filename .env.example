# Copy to .env and fill in. Never commit .env.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave unset for the PayPal sandbox (no real money). For real payouts:
# PAYPAL_BASE_URL=https://api-m.paypal.com
GEMINI_API_KEY=
# Optional: another Gemini model (default gemini-3.8-flash) if the default is busy or out of quota.
# GEMINI_MODEL=gemini-3.7-flash
# Optional: the model asked when the main one is overloaded or out of quota (default gemini-2.5-flash).
# GEMINI_BACKUP_MODEL=gemini-2.5-flash
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=
# Sign in with GitHub: github.com/settings/developers > OAuth Apps > New OAuth App.
# Authorization callback URL: <PUBLIC_URL>/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The address people open, e.g. https://mergepay.onrender.com. Used for the sign-in callback and
# the webhook URL shown in Settings. Leave empty locally (http://127.0.0.1:8000 is used).
PUBLIC_URL=
# Optional operator login that sees everything (any username works). Required if GitHub
# sign-in isn't set up.
ADMIN_PASSWORD=
# Where the SQLite database lives. Point it at a persistent disk in production.
DB_PATH=mergepay.db
# Bounties at or below this are paid automatically when the AI judge agrees.
AUTO_PAY_LIMIT=50
